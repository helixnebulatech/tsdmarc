{
  "name": "tsdmarc-repo",
  "private": true,
  "description": "tsdmarc monorepo: DMARC and SMTP TLS report parser for TypeScript, a port of parsedmarc",
  "homepage": "https://github.com/helixnebulatech/tsdmarc#readme",
  "author": "HelixNebula (https://helixnebula.tech)",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "changeset": "changeset",
    "check": "ultracite check",
    "ci:release": "turbo clean && pnpm build:packages && changeset publish",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "clean": "turbo clean",
    "fix": "ultracite fix",
    "fixtures": "TZ=UTC .venv/bin/python -I tools/fixtures/generate.py",
    "prepare": "lefthook install",
    "pack:check": "node tools/pack-check.mjs",
    "publint": "turbo publint",
    "test": "turbo test",
    "test:smoke": "pnpm build:packages && node tools/smoke/run.mjs",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "publint": "0.3.25",
    "turbo": "2.11.10",
    "ultracite": "8.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0"
}
