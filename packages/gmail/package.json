{
  "name": "@tsdmarc/gmail",
  "version": "0.0.0",
  "description": "Gmail API mailbox connection for tsdmarc: read DMARC and SMTP TLS reports from Gmail or Google Workspace (port of mailsuite.mailbox.gmail).",
  "license": "Apache-2.0",
  "author": "HelixNebula (https://helixnebula.tech)",
  "homepage": "https://github.com/helixnebulatech/tsdmarc/tree/main/packages/gmail#readme",
  "bugs": {
    "url": "https://github.com/helixnebulatech/tsdmarc/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "node ../../tools/license-files.mjs",
    "publint": "publint && attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.2",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tsdmarc/tsconfig": "workspace:*",
    "@tsdmarc/tsdown-config": "workspace:*",
    "@types/node": "26.6.6",
    "tsdmarc": "workspace:*",
    "tsdown": "0.23.7",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "tsdmarc": "workspace:^"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helixnebulatech/tsdmarc.git",
    "directory": "packages/gmail"
  },
  "keywords": [
    "dmarc",
    "tsdmarc",
    "gmail",
    "gmail-api",
    "google-workspace",
    "mailbox",
    "dmarc-reports"
  ]
}
