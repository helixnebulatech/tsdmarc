{
  "name": "@tsdmarc/msgraph",
  "version": "0.0.0",
  "description": "Microsoft Graph mailbox connection for tsdmarc: read DMARC and SMTP TLS reports from Microsoft 365 / Exchange Online (port of mailsuite.mailbox.graph).",
  "license": "Apache-2.0",
  "author": "HelixNebula (https://helixnebula.tech)",
  "homepage": "https://github.com/helixnebulatech/tsdmarc/tree/main/packages/msgraph#readme",
  "bugs": {
    "url": "https://github.com/helixnebulatech/tsdmarc/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepack": "node ../../tools/license-files.mjs",
    "publint": "publint && attw --pack . --profile esm-only --ignore-rules cjs-resolves-to-esm",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tsdmarc/tsconfig": "workspace:*",
    "@tsdmarc/tsdown-config": "workspace:*",
    "@types/node": "26.6.6",
    "tsdmarc": "workspace:*",
    "tsdown": "0.23.7",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@azure/identity-cache-persistence": "^1.0.0",
    "tsdmarc": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@azure/identity-cache-persistence": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helixnebulatech/tsdmarc.git",
    "directory": "packages/msgraph"
  },
  "keywords": [
    "dmarc",
    "tsdmarc",
    "microsoft-graph",
    "microsoft-365",
    "office-365",
    "exchange-online",
    "outlook",
    "mailbox",
    "dmarc-reports"
  ]
}
